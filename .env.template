# ============================================
# ANALYTICS API SERVICE ENVIRONMENT VARIABLES
# ============================================

# Service Configuration
SERVICE_NAME=analytics-api
SERVICE_PORT=8003
ENVIRONMENT=development
RELOAD=true

# Database Configuration
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/analytics_db

# Transaction Service (data source)
TRANSACTION_SERVICE_URL=http://localhost:8006

# Categorizer Service (category data)
CATEGORIZER_SERVICE_URL=http://localhost:8009

# Auth Service (authentication)
AUTH_SERVICE_URL=http://localhost:8001

# Logging
LOG_LEVEL=INFO
LOG_JSON_ENABLED=false

# Redis (for caching)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/2

# Development Settings
DEV_MODE=true
